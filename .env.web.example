# Copy to .env next to compose.web.yml, chmod 600, and edit before starting.
# Use a unique long random password. Never commit your .env.
FLOW_WEB_PASSWORD=
FLOW_WEB_ORIGIN=http://127.0.0.1:8780
FLOW_WEB_PUBLISH_HOST=127.0.0.1
FLOW_WEB_PORT=8780
FLOW_WEB_DIRECT_MEDIA=1
# Optional, read-only Flow Sync server readiness check. Pairing not available yet.
FLOW_WEB_SYNC_URL=
